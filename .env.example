# -------------------------------------------------------------
# DIGIVERSE XRE Backend — env template.
# Copy to .env and fill in real values. NEVER commit .env.
# -------------------------------------------------------------

# Permanent Google AI Studio key. Server-side ONLY.
GEMINI_API_KEY=paste_your_permanent_key_here

# Gemini Live model to lock in every ephemeral token.
# Override here without touching Unity code.
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Official Live API WebSocket for ephemeral tokens (v1beta constrained).
# Token is minted via @google/genai authTokens.create() — do not set a REST token URL.
GEMINI_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained

# Token lifetime (seconds).
TOKEN_EXPIRY_SECONDS=1800
NEW_SESSION_EXPIRY_SECONDS=60

# HTTP server config.
PORT=8787
ALLOWED_ORIGIN=*

# Optional shared secret. If set, Unity must send it in the Authorization header.
CLIENT_SHARED_SECRET=
